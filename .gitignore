# =============================================
# .gitignore — lusthub.my.id project
# =============================================

# Dependensi Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel CLI cache & local builds
.vercel/

# File output / temporary
result.txt
output.log
*.log

# Environment variables & secrets (jangan sampai ter-commit ke git)
.env
.env*.local
.env.development*
.env.production*
.env.test*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Antigravity agent & temporary workspace
.agents/
scratch/
graphify-out/

# Vercel build-time pre-rendered static CDN pages (generated by `node build-static.mjs`)
/c/
/v/
/de/
/fr/
/es/
/it/
/nl/
/pt/
/pl/
/de.html
/fr.html
/es.html
/it.html
/nl.html
/pt.html
/pl.html
/trending.html
/top-rated.html
/longest.html
/jav.html
/categories.html
/saved.html
/assets/data/
