# =============================================
# .gitignore — lusthub.my.id project
# =============================================

# Dependensi Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel CLI cache & local builds
.vercel/

# File output / temporary
result.txt
output.log
*.log

# Environment variables & secrets (jangan sampai ter-commit ke git)
.env
.env*.local
.env.development*
.env.production*
.env.test*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Antigravity agent & temporary workspace
.agents/
scratch/
graphify-out/
