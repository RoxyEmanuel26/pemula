{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "includeFiles": "{lib/**,data/runtime/**,data/category-descriptions.json,data/eu-locales.json}"
    }
  },
  "redirects": [
    { "source": "/video.html", "destination": "/", "permanent": true },
    { "source": "/video", "destination": "/", "permanent": true },
    { "source": "/category.html", "destination": "/categories", "permanent": true },
    { "source": "/category", "destination": "/categories", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "q" }], "destination": "/api/home?lang=en" },
    { "source": "/", "has": [{ "type": "query", "key": "page" }], "destination": "/api/home?lang=en" },
    { "source": "/trending", "destination": "/api/discover?view=trending" },
    { "source": "/top-rated", "destination": "/api/discover?view=top-rated" },
    { "source": "/longest", "destination": "/api/discover?view=longest" },
    { "source": "/jav", "destination": "/api/discover?view=jav" },
    { "source": "/categories", "destination": "/api/discover?view=categories" },
    { "source": "/saved", "destination": "/api/discover?view=saved" },
    { "source": "/api/suggest", "destination": "/api/discover?view=suggest" },
    { "source": "/de", "destination": "/api/home?lang=de" },
    { "source": "/fr", "destination": "/api/home?lang=fr" },
    { "source": "/es", "destination": "/api/home?lang=es" },
    { "source": "/it", "destination": "/api/home?lang=it" },
    { "source": "/nl", "destination": "/api/home?lang=nl" },
    { "source": "/pt", "destination": "/api/home?lang=pt" },
    { "source": "/pl", "destination": "/api/home?lang=pl" },
    { "source": "/de/c/:slug*", "destination": "/api/category?lang=de&slug=:slug*" },
    { "source": "/fr/c/:slug*", "destination": "/api/category?lang=fr&slug=:slug*" },
    { "source": "/es/c/:slug*", "destination": "/api/category?lang=es&slug=:slug*" },
    { "source": "/it/c/:slug*", "destination": "/api/category?lang=it&slug=:slug*" },
    { "source": "/nl/c/:slug*", "destination": "/api/category?lang=nl&slug=:slug*" },
    { "source": "/pt/c/:slug*", "destination": "/api/category?lang=pt&slug=:slug*" },
    { "source": "/pl/c/:slug*", "destination": "/api/category?lang=pl&slug=:slug*" },
    { "source": "/v/:slug*", "destination": "/api/video?slug=:slug*" },
    { "source": "/c/:slug*", "destination": "/api/category?slug=:slug*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/404",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(video|category|ad-wrapper)(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(saved|api/suggest)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(de|fr|es|it|nl|pt|pl)",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(de|fr|es|it|nl|pt|pl)",
      "has": [{ "type": "query", "key": "page" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "ref" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "order" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/((?!assets/|sitemap_index\\.xml|sitemap\\.xml|sitemaps|feed\\.xml|robots\\.txt).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "Rating", "value": "RTA-5042-1996-1400-1577-RTA" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=300, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sitemap_index.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=300, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=300, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sitemaps/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=300, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=300, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
