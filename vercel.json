{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node build-static.mjs",
  "outputDirectory": ".",
  "functions": {
    "api/video.js": {
      "includeFiles": "{lib/**,data/runtime/**,data/category-descriptions.json}"
    },
    "api/category.js": {
      "includeFiles": "{lib/**,data/runtime/index.json,data/category-descriptions.json,data/eu-locales.json}"
    }
  },
  "redirects": [
    { "source": "/video.html", "destination": "/", "permanent": true },
    { "source": "/video", "destination": "/", "permanent": true },
    { "source": "/category.html", "destination": "/categories", "permanent": true },
    { "source": "/category", "destination": "/categories", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "q", "value": "(?<term>[^&]+)" }], "destination": "/c/:term", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap_pages.xml", "destination": "/sitemaps/sitemap_pages.xml" },
    { "source": "/sitemap_categories.xml", "destination": "/sitemaps/sitemap_categories.xml" },
    { "source": "/sitemap_compound.xml", "destination": "/sitemaps/sitemap_compound.xml" },
    { "source": "/sitemap_eu_locales.xml", "destination": "/sitemaps/sitemap_eu_locales.xml" },
    { "source": "/sitemap_videos_:num.xml", "destination": "/sitemaps/sitemap_videos_:num.xml" },
    { "source": "/de/c/:slug*", "destination": "/api/category?lang=de&slug=:slug*" },
    { "source": "/fr/c/:slug*", "destination": "/api/category?lang=fr&slug=:slug*" },
    { "source": "/es/c/:slug*", "destination": "/api/category?lang=es&slug=:slug*" },
    { "source": "/it/c/:slug*", "destination": "/api/category?lang=it&slug=:slug*" },
    { "source": "/nl/c/:slug*", "destination": "/api/category?lang=nl&slug=:slug*" },
    { "source": "/pt/c/:slug*", "destination": "/api/category?lang=pt&slug=:slug*" },
    { "source": "/pl/c/:slug*", "destination": "/api/category?lang=pl&slug=:slug*" },
    { "source": "/v/:slug*", "destination": "/api/video?slug=:slug*" },
    { "source": "/c/:slug*", "destination": "/api/category?slug=:slug*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/404",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=604800, stale-while-revalidate=2592000" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(video|category|ad-wrapper)(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/saved",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(de|fr|es|it|nl|pt|pl)",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(de|fr|es|it|nl|pt|pl)",
      "has": [{ "type": "query", "key": "page" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "ref" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "order" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/((?!assets/|sitemap[^/]*\\.xml|sitemaps|feed\\.xml|robots\\.txt).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=604800, stale-while-revalidate=2592000" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=604800, stale-while-revalidate=2592000" },
        { "key": "Rating", "value": "RTA-5042-1996-1400-1577-RTA" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/sitemap(.*)\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=21600, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=21600, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=21600, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=21600, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=21600, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=21600, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sitemaps/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=21600, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=21600, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=21600, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=86400, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "s-maxage=86400, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
